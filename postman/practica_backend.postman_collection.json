        {
          "name": "obtenerDirecciones",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/direcciones/usuario/{{userId}}?nickUsuario={{nickUsuario}}&nickContrasena={{nickContrasena}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "direcciones", "usuario", "{{userId}}"],
